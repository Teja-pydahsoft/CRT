# Copy to .env and replace every placeholder before deployment.
# Keep passwords URL-safe (letters and numbers) because they are embedded in
# the MongoDB connection URI.
MONGO_ROOT_USERNAME=crt_admin
MONGO_ROOT_PASSWORD=replace_with_a_long_random_password
MONGO_DATABASE=crt

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_REFRESH_SECRET_KEY=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Local speech model settings (no external AI API key required)
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=2

# Optional integrations
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
BREVO_API_KEY=
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=VERSANT Testing System

# Optional external MySQL/RDS source used by SDMS/organization features
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=student_database
DB_SSL=false
USE_RDS_ORG_DATA=false
MYSQL_RDS_READ_ONLY=false

# Set this to the public frontend origin(s) when browser clients connect directly.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,https://your-domain.example
FRONTEND_PORT=80

# For production, set these to image tags pushed by your CI/build machine.
# BACKEND_IMAGE=your-registry/versant-backend:release
# AI_SERVER_IMAGE=your-registry/versant-ai-server:release
# FRONTEND_IMAGE=your-registry/versant-frontend:release
